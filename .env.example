# Copy to .env for docker compose:  cp .env.example .env
# Development values only. Every credential here is fake and public; replace them all for any real deployment.

# 32+ characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# Demo users for POST /auth/token, as name:sha256(password):roles
#   clinician / clinician-dev-pw  -> submitter
#   reviewer  / reviewer-dev-pw   -> viewer
#   admin     / admin-dev-pw      -> admin
# Hash a password with: python scripts/hash_secret.py 'the-password'
DEMO_USERS=clinician:3beed1bf84a08273122b04cf20524393ad72d4a1bbaf4fce8ed4998fde9b7eb2:submitter,reviewer:76aa4cef2bb25b148ad145638d71cf7af4b631a853b2d3645e53465b05f3648c:viewer,admin:f4c09c2daa1c97e387543d7ef15f8ca78dcae26e087a27037845208258124633:admin

# Partner system API keys, as name:sha256(key):roles
#   partner-ehr / dev-partner-key-change-me -> submitter
API_KEYS=partner-ehr:107e6aa921f10f6477221ce6bc70daf6d61a7db20d4b7ccb0cbe5f3f4b8f8a91:submitter

# Where the worker resolves patientReference values. The public HAPI test server by default;
# use http://mock-payer:8081/fhir to run with no internet (serves Patient/fake-1001 and fake-1002).
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

MAX_ATTEMPTS=3
RETRY_DELAY_MS=5000
PAYER_TIMEOUT_SECONDS=2

GRAFANA_ADMIN_PASSWORD=admin-dev-pw
